# =============================================================================
# REQUIRED CORE CREDENTIALS
# =============================================================================
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
DATABASE_URL=

# =============================================================================
# OPTIONAL AI PROVIDERS
# =============================================================================
GROQ_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
GROQ_MODEL_POOL=
MISTRAL_MODEL_POOL=

# NVIDIA media configuration is intentionally configuration-driven.
# Image models are NVIDIA hosted NIM media endpoints; availability/cost is controlled by NVIDIA.
NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
NVIDIA_IMAGE_MODEL=
NVIDIA_IMAGE_MODEL_POOL=

# NVIDIA Cosmos 3 Generator is currently exposed by NVIDIA as a free development endpoint.
# Keep the endpoint/model configurable so a future hosted or self-hosted endpoint can replace it without code changes.
NVIDIA_VIDEO_ENDPOINT=
NVIDIA_VIDEO_BASE_URL=https://ai.api.nvidia.com/v1/genai
NVIDIA_VIDEO_MODEL=
NVIDIA_VIDEO_MODEL_POOL=
NVIDIA_VIDEO_RESOLUTION=480
NVIDIA_VIDEO_FRAMES=121
NVIDIA_VIDEO_FPS=24
NVIDIA_VIDEO_STEPS=35

AI_MULTI_PROVIDER_ROUTING_ENABLED=true

# =============================================================================
# HUGGING FACE / GENERATED MEDIA
# =============================================================================
HF_TOKEN=
HF_TEXT_MODEL=
HF_TEXT_MODEL_POOL=
HF_IMAGE_MODEL=
HF_IMAGE_MODEL_POOL=
HF_VIDEO_MODEL=
HF_VIDEO_MODEL_POOL=

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# OPTIONAL LIVE WEB RESEARCH
# =============================================================================
TAVILY_API_KEY=
TAVILY_TIMEOUT_MS=30000

# =============================================================================
# TELEGRAM / WEBHOOK / ACCESS CONTROL
# =============================================================================
TELEGRAM_DEFAULT_REACTION=👀
TELEGRAM_THINKING_TEXT=💭 Thinking
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
ALLOWED_TELEGRAM_USER_IDS=
ADMIN_USER_IDS=

# =============================================================================
# MODEL / KEY ROTATION
# =============================================================================
GEMINI_MODEL=
GEMINI_MODEL_FAST=
GEMINI_MODEL_REASONING=
GEMINI_MODEL_EXTRACTION=
GEMINI_EMBEDDING_MODEL=
KEY_ROTATION_MODE=

# =============================================================================
# PERFORMANCE / EXECUTION
# =============================================================================
PRISMA_ACCELERATE_URL=
EXECUTION_ENGINE_ENABLED=true
EXECUTION_MAX_CONCURRENCY=10
EXECUTION_MAX_PER_USER=3
