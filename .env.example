# =============================================================================
# REQUIRED CORE CREDENTIALS
# =============================================================================

# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Google Gemini API key (supports single key or comma-separated pool: key1,key2,key3...)
GEMINI_API_KEY=

# PostgreSQL database connection URL
DATABASE_URL=

# =============================================================================
# OPTIONAL AI PROVIDERS
# =============================================================================

# Groq API key. Provider/model selection is managed from the Web Dashboard.
GROQ_API_KEY=

# Mistral API key. Provider/model selection is managed from the Web Dashboard.
MISTRAL_API_KEY=

# Optional bootstrap model pools. These are only used when PostgreSQL has no unified model registry yet.
# Comma-separated provider model IDs; do not use these as the long-term source of truth.
GROQ_MODEL_POOL=
MISTRAL_MODEL_POOL=

# Enable provider-neutral adaptive routing for ordinary text turns.
# Set false to keep the existing Gemini-only execution path during emergency rollback.
AI_MULTI_PROVIDER_ROUTING_ENABLED=true

# =============================================================================
# OPTIONAL LIVE WEB RESEARCH
# =============================================================================

# Tavily server-side API key. Never expose this as NEXT_PUBLIC_TAVILY_API_KEY.
# When configured, Wingbuddy can use live web search/extraction through the Tool Registry.
TAVILY_API_KEY=

# Tavily request timeout in milliseconds (default: 30000)
TAVILY_TIMEOUT_MS=30000

# =============================================================================
# OPTIONAL TELEGRAM INTERACTION PRESENTATION
# =============================================================================

# Default acknowledgement reaction for supported incoming interactions.
TELEGRAM_DEFAULT_REACTION=👀

# User-facing reasoning-stage progress label. Shown only when runtime state is
# explicitly marked as reasoning + userFacingProgress=true. Leave blank to use
# the built-in default.
TELEGRAM_THINKING_TEXT=💭 Thinking

# =============================================================================
# OPTIONAL WEBHOOK CONFIGURATION
# =============================================================================

# Webhook public HTTPS endpoint URL (if left blank, bot uses zero-config Long Polling)
TELEGRAM_WEBHOOK_URL=

# Secret token for validating Telegram webhook requests (sent in X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# =============================================================================
# OPTIONAL ACCESS CONTROL, ADMIN & MODEL SETTINGS
# =============================================================================

# Comma-separated list of allowed Telegram user IDs (if left blank, bot is open to all users)
ALLOWED_TELEGRAM_USER_IDS=

# Comma-separated list of administrator Telegram user IDs with privileged controls
ADMIN_USER_IDS=

# Optional Gemini model bootstrap value. Once PostgreSQL contains AI_MODEL_REGISTRY,
# the unified model registry becomes authoritative for model selection.
GEMINI_MODEL=

# Optional role-specific Gemini bootstrap model values. Dashboard/model registry supersedes these after hydration.
GEMINI_MODEL_FAST=
GEMINI_MODEL_REASONING=
GEMINI_MODEL_EXTRACTION=
GEMINI_EMBEDDING_MODEL=

# API key rotation strategy: "round-robin" or "failover" (defaults to round-robin)
KEY_ROTATION_MODE=

# =============================================================================
# OPTIONAL PERFORMANCE, ADAPTIVE CACHING & CONNECTION POOLING
# =============================================================================

# Optional Prisma Accelerate endpoint for serverless connection pooling & edge caching
# (If unset, Prisma automatically connects directly to DATABASE_URL)
PRISMA_ACCELERATE_URL=

# =============================================================================
# AUTONOMOUS EXECUTION ENGINE CONFIGURATION
# =============================================================================

# Enable autonomous multi-step execution engine ("true" or "false")
EXECUTION_ENGINE_ENABLED=true

# Maximum global concurrent node executions (1-50, default: 10)
EXECUTION_MAX_CONCURRENCY=10

# Maximum concurrent execution sessions per user (1-20, default: 3)
EXECUTION_MAX_PER_USER=3

# Database row lease duration in ms (5000-120000, default: 30000)
EXECUTION_LEASE_DURATION_MS=30000

# Default per-node execution timeout in ms (1000-300000, default: 60000)
EXECUTION_DEFAULT_TIMEOUT_MS=60000

# Maximum automatic retries for transient node failures (0-5, default: 3)
EXECUTION_MAX_RETRIES=3
