# Telegram Bot credentials from @BotFather
TELEGRAM_BOT_TOKEN=

# Google Gemini API key
GEMINI_API_KEY=

# PostgreSQL database connection URL (e.g. from Cloud SQL or local database)
DATABASE_URL=

# Model selection (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Optional comma-separated Telegram user IDs to restrict bot access
ALLOWED_TELEGRAM_USER_IDS=

# Chat memory and rate limiting configuration
MAX_HISTORY_MESSAGES=20
RATE_LIMIT_MAX_REQUESTS=6
RATE_LIMIT_WINDOW_MS=60000
GEMINI_TIMEOUT_MS=45000

# Webhook configuration (leave empty to use polling)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Server port (AI Studio standard is 3000)
PORT=3000
