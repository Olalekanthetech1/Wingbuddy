{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/api-server",
    "build": "tsc --build && npm run build --workspace=@workspace/api-server",
    "lint": "tsc --build",
    "typecheck:libs": "tsc --build",
    "typecheck": "tsc --build && npm run typecheck --workspace=@workspace/api-server",
    "test": "npm run test --workspace=@workspace/api-server"
  },
  "private": true,
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@replit/connectors-sdk": "^0.4.1",
    "prisma": "^6.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
