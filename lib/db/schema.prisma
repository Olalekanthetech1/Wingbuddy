datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Registered Telegram users interacting with the assistant
model User {
  id                  Int            @id @default(autoincrement())
  telegramUserId      BigInt         @unique @map("telegram_user_id")
  username            String?
  firstName           String?        @map("first_name")
  lastName            String?        @map("last_name")
  personality         String         @default("playful")
  mode                String         @default("general")
  tier                String         @default("free")
  dailyQuota          Int            @default(30) @map("daily_quota")
  requestsToday       Int            @default(0) @map("requests_today")
  lastRequestDate     String         @default("") @map("last_request_date")
  totalRequests       Int            @default(0) @map("total_requests")
  customModelOverride String?        @map("custom_model_override")
  status              String         @default("active")
  lastActiveAt        DateTime       @default(now()) @map("last_active_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at")

  // Relationships
  conversations  Conversation[]
  memories       UserMemory[]
  reminders      Reminder[]

  @@map("users")
}

/// Chat sessions per user and Telegram chat
model Conversation {
  id             Int          @id @default(autoincrement())
  telegramUserId BigInt       @map("telegram_user_id")
  chatId         BigInt       @map("chat_id")
  title          String?
  summary        String?      @db.Text
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  // Relationships
  user           User?        @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Cascade)
  messages       Message[]

  @@unique([telegramUserId, chatId], map: "conversations_user_chat_idx")
  @@index([chatId], map: "conversations_chat_id_idx")
  @@index([telegramUserId, isActive], map: "conversations_user_active_idx")
  @@map("conversations")
}

/// Message history storing dialog context between user and Gemini assistant
model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  role           String
  content        String       @db.Text
  tokenCount     Int?         @map("token_count")
  createdAt      DateTime     @default(now()) @map("created_at")

  // Relationships
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "messages_conversation_created_idx")
  @@map("messages")
}

/// Long-term persistent memory for user preferences, facts, and profile knowledge
model UserMemory {
  id                   Int       @id @default(autoincrement())
  telegramUserId       BigInt    @map("telegram_user_id")
  key                  String    @db.VarChar(128)
  content              String    @db.Text
  category             String    @default("general") @db.VarChar(64)
  type                 String    @default("user_fact") @db.VarChar(64)
  structuredValue      String?   @map("structured_value") @db.Text
  confidence           String    @default("high") @db.VarChar(16)
  importance           String    @default("medium") @db.VarChar(16)
  status               String    @default("active") @db.VarChar(16)
  embeddingJson        String?   @map("embedding_json") @db.Text
  sourceSessionId      Int?      @map("source_session_id")
  sourceMessageId      Int?      @map("source_message_id")
  sourceConversationId Int?      @map("source_conversation_id")
  expiresAt            DateTime? @map("expires_at")
  lastAccessedAt       DateTime? @map("last_accessed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relationships
  user User? @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Cascade)

  @@unique([telegramUserId, key], map: "user_memories_user_key_idx")
  @@index([telegramUserId, category], map: "user_memories_user_category_idx")
  @@index([telegramUserId, status], map: "user_memories_user_status_idx")
  @@map("user_memories")
}

/// Agent Multi-Step Tasks
model AgentTask {
  id             Int       @id @default(autoincrement())
  telegramUserId BigInt    @map("telegram_user_id")
  conversationId Int?      @map("conversation_id")
  title          String    @db.Text
  goal           String    @db.Text
  taskType       String    @default("general") @map("task_type")
  status         String    @default("pending")
  currentStep    Int       @default(1) @map("current_step")
  contextJson    String?   @map("context_json") @db.Text
  metadataJson   String?   @map("metadata_json") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")

  @@index([telegramUserId, status], map: "agent_tasks_user_status_idx")
  @@index([telegramUserId, updatedAt], map: "agent_tasks_user_updated_idx")
  @@map("agent_tasks")
}

/// Agent Task Execution Steps
model AgentTaskStep {
  id            Int      @id @default(autoincrement())
  taskId        Int      @map("task_id")
  stepOrder     Int      @map("step_order")
  title         String   @db.Text
  description   String?  @db.Text
  status        String   @default("pending")
  resultSummary String?  @map("result_summary") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([taskId, stepOrder], map: "agent_task_steps_task_step_idx")
  @@map("agent_task_steps")
}

/// Summaries for past conversation turns
model ConversationSummary {
  id                     Int      @id @default(autoincrement())
  telegramUserId         BigInt   @map("telegram_user_id")
  conversationId         Int      @map("conversation_id")
  summary                String   @db.Text
  keyTakeawaysJson       String?  @map("key_takeaways_json") @db.Text
  artifactRefsJson       String?  @map("artifact_refs_json") @db.Text
  messageCountSummarized Int      @default(0) @map("message_count_summarized")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([telegramUserId, conversationId], map: "conversation_summaries_user_conv_idx")
  @@map("conversation_summaries")
}

/// Scheduled proactive reminders with recurring checks and natural language parsing
model Reminder {
  id             Int      @id @default(autoincrement())
  telegramUserId BigInt   @map("telegram_user_id")
  chatId         BigInt   @map("chat_id")
  prompt         String   @db.Text
  dueAt          DateTime @map("due_at")
  isCompleted    Boolean  @default(false) @map("is_completed")
  snoozeCount    Int      @default(0) @map("snooze_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  // Relationships
  user User? @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Cascade)

  @@index([telegramUserId, isCompleted], map: "reminders_user_completed_idx")
  @@index([dueAt, isCompleted], map: "reminders_due_completed_idx")
  @@map("reminders")
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Persisted Execution Graphs
model ExecutionGraphRecord {
  id             Int       @id @default(autoincrement())
  graphId        String    @unique @map("graph_id")
  telegramUserId BigInt    @map("telegram_user_id")
  latestRevision Int       @default(1) @map("latest_revision")
  status         String    @default("ready")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([telegramUserId], map: "execution_graphs_user_idx")
  @@index([status], map: "execution_graphs_status_idx")
  @@map("execution_graphs")
}

/// Immutable Graph Revisions
model GraphRevisionRecord {
  id               Int       @id @default(autoincrement())
  graphId          String    @map("graph_id")
  planRevision     Int       @map("plan_revision")
  revisionId       String    @unique @map("revision_id")
  parentRevisionId String?   @map("parent_revision_id")
  telegramUserId   BigInt    @map("telegram_user_id")
  goal             String    @db.Text
  status           String    @default("ready")
  graphJson        String    @map("graph_json") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([graphId, planRevision], map: "graph_revisions_graph_rev_idx")
  @@index([telegramUserId], map: "graph_revisions_user_idx")
  @@map("graph_revisions")
}

/// Durable Execution Sessions
model ExecutionSessionRecord {
  id               Int       @id @default(autoincrement())
  executionId      String    @unique @map("execution_id")
  requestId        String    @map("request_id")
  taskId           Int?      @map("task_id")
  graphId          String    @map("graph_id")
  planRevision     Int       @map("plan_revision")
  revisionId       String    @map("revision_id")
  telegramUserId   BigInt    @map("telegram_user_id")
  status           String    @default("ready")
  currentNodesJson String?   @map("current_nodes_json") @db.Text
  errorJson        String?   @map("error_json") @db.Text
  startedAt        DateTime  @default(now()) @map("started_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  completedAt      DateTime? @map("completed_at")

  @@index([graphId, planRevision], map: "execution_sessions_graph_rev_idx")
  @@index([status], map: "execution_sessions_status_idx")
  @@index([telegramUserId], map: "execution_sessions_user_idx")
  @@map("execution_sessions")
}

/// Node Execution Attempts & Audit Log
model NodeExecutionRecord {
  id             Int       @id @default(autoincrement())
  executionId    String    @map("execution_id")
  graphId        String    @map("graph_id")
  planRevision   Int       @map("plan_revision")
  nodeId         String    @map("node_id")
  attempt        Int       @default(1)
  idempotencyKey String    @unique @map("idempotency_key")
  status         String
  workerId       String?   @map("worker_id")
  resultJson     String?   @map("result_json") @db.Text
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message") @db.Text
  isRetryable    Boolean   @default(false) @map("is_retryable")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  @@index([graphId, planRevision, nodeId], map: "node_executions_graph_node_idx")
  @@index([idempotencyKey], map: "node_executions_idempotency_idx")
  @@index([status], map: "node_executions_status_idx")
  @@map("node_executions")
}

/// Durable Distributed Execution Leases
model ExecutionLeaseRecord {
  id             Int      @id @default(autoincrement())
  leaseKey       String   @unique @map("lease_key")
  executionId    String   @map("execution_id")
  graphId        String   @map("graph_id")
  planRevision   Int      @map("plan_revision")
  nodeId         String   @map("node_id")
  workerId       String   @map("worker_id")
  attempt        Int      @default(1)
  claimedAt      DateTime @default(now()) @map("claimed_at")
  leaseExpiresAt DateTime @map("lease_expires_at")

  @@index([leaseExpiresAt], map: "execution_leases_expires_idx")
  @@index([graphId, planRevision, nodeId], map: "execution_leases_graph_node_idx")
  @@map("execution_leases")
}

/// Execution Approvals
model ExecutionApprovalRecord {
  id               Int       @id @default(autoincrement())
  approvalId       String    @unique @map("approval_id")
  telegramUserId   BigInt    @map("telegram_user_id")
  graphId          String    @map("graph_id")
  planRevision     Int       @map("plan_revision")
  nodeId           String    @map("node_id")
  status           String    @default("pending")
  reason           String    @db.Text
  requestedAt      DateTime  @default(now()) @map("requested_at")
  resolvedAt       DateTime? @map("resolved_at")
  expiresAt        DateTime? @map("expires_at")
  resolvedByUserId BigInt?   @map("resolved_by_user_id")

  @@index([telegramUserId], map: "execution_approvals_user_idx")
  @@index([graphId, planRevision, nodeId], map: "execution_approvals_graph_node_idx")
  @@index([status], map: "execution_approvals_status_idx")
  @@map("execution_approvals")
}

